{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "getpaweer.app"
        }
      ],
      "destination": "https://www.pawwerapp.com/#contenido",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "getpaweer.app"
        }
      ],
      "destination": "https://www.pawwerapp.com/#contenido",
      "permanent": true
    }
  ],
  "builds": [
    {
      "src": "api/meta-config.js",
      "use": "@vercel/node"
    },
    {
      "src": "index.html",
      "use": "@vercel/static"
    },
    {
      "src": "app.js",
      "use": "@vercel/static"
    },
    {
      "src": "styles.css",
      "use": "@vercel/static"
    },
    {
      "src": "pawwer-mark.png",
      "use": "@vercel/static"
    },
    {
      "src": "assets/pawwer-freelancer-post-es.jpg",
      "use": "@vercel/static"
    },
    { "src": "assets/foto-*.jpg", "use": "@vercel/static" },
    { "src": "assets/*.png", "use": "@vercel/static" }
  ]
}
